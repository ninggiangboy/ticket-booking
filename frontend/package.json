{
  "name": "ticket-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "e2e": "playwright test",
    "lint": "eslint . && stylelint \"src/**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "i18n:check": "node scripts/i18n-check.mjs",
    "gen:api": "openapi-typescript ../api/openapi.yaml -o src/api/schema.d.ts && prettier --write src/api/schema.d.ts"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@tanstack/react-query": "^5.104.2",
    "i18next": "^26.4.4",
    "i18next-icu": "^2.5.0",
    "intl-messageformat": "^12.1.3",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.16",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "playwright-core": "~1.59.1",
    "prettier": "^3.9.9",
    "stylelint": "^17.16.0",
    "stylelint-declaration-strict-value": "^1.12.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
