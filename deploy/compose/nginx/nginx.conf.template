# /etc/nginx/templates/default.conf.template, included in the http context (DOC-62 §8).
geo $limited { default 1; include /etc/nginx/allowlist.conf; }      # DR-55: allowlisted IPs skip limit_req
map $limited $limit_key { 1 $binary_remote_addr; 0 ""; }             # empty key = not limited
map "$request_method:$limited" $hold_key { "POST:1" $binary_remote_addr; default ""; }

# Client request ids are kept only when well formed, otherwise nginx makes a new one (DOC-36 §6.1)
map $http_x_request_id $req_id { "~^[A-Za-z0-9-]{8,64}$" $http_x_request_id; default $request_id; }

# DR-99: the magic link token stays out of logs and Referer
map $uri $referrer_policy { /auth/callback no-referrer; default strict-origin-when-cross-origin; }
log_format no_query '$remote_addr - $remote_user [$time_local] "$request_method $uri $server_protocol" '
                    '$status $body_bytes_sent $request_time "$req_id"';
access_log /var/log/nginx/access.log no_query;

limit_req_zone $limit_key zone=api_ip:10m  rate=20r/s;
limit_req_zone $limit_key zone=auth_ip:1m  rate=10r/m;
limit_req_zone $hold_key  zone=hold_ip:10m rate=5r/s;
limit_req_status 429;

proxy_cache_path /var/cache/nginx/api   levels=1:2 keys_zone=api_cache:10m   max_size=200m inactive=1d use_temp_path=off;
proxy_cache_path /var/cache/nginx/media levels=1:2 keys_zone=media_cache:10m max_size=1g   inactive=1d use_temp_path=off;

upstream api { server api:8081; keepalive 64; }

server {
  listen 80;
  server_name _;
  client_max_body_size 6m;                                            # floor plan <= 5 MB (DR-38)

  include /etc/nginx/snippets/security-headers.conf;
  # Strict-Transport-Security is added only behind TLS (not in dev)

  proxy_http_version 1.1;
  proxy_set_header Connection "";
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;                            # overwrites anything the client sent (DR-100)
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_set_header X-Request-Id $req_id;                              # api puts it in MDC as trace_id (DR-09)

  location = /healthz { access_log off; default_type text/plain; return 200 "ok\n"; }

  location = /api/v1/auth/magic-link {
    limit_req zone=auth_ip burst=5 nodelay;
    limit_req zone=api_ip burst=40 nodelay;
    error_page 429 = @rate_limited;
    error_page 502 503 504 = @upstream_unavailable;
    proxy_pass http://api;
  }
  location ~ ^/api/v1/events/[^/]+/reservations$ {
    limit_req zone=hold_ip burst=10 nodelay;
    limit_req zone=api_ip burst=40 nodelay;
    error_page 429 = @rate_limited;
    error_page 502 503 504 = @upstream_unavailable;
    proxy_pass http://api;
  }
  # Seat map documents are immutable per version: cache 1 day (DR-55). No cookie goes upstream so nothing user-specific is cached
  location ~ ^/api/v1/events/[^/]+/map$ {
    include /etc/nginx/snippets/security-headers.conf;
    limit_req zone=api_ip burst=40 nodelay;
    error_page 429 = @rate_limited;
    error_page 502 503 504 = @upstream_unavailable;
    proxy_cache api_cache; proxy_cache_key "$scheme$request_uri";
    proxy_cache_valid 200 1d; proxy_cache_lock on;
    proxy_set_header Cookie "";
    add_header X-Cache-Status $upstream_cache_status always;
    proxy_pass http://api;
  }
  location ~ ^/api/v1/events/[^/]+$ {                                 # public event detail, cached 5 seconds
    include /etc/nginx/snippets/security-headers.conf;
    limit_req zone=api_ip burst=40 nodelay;
    error_page 429 = @rate_limited;
    error_page 502 503 504 = @upstream_unavailable;
    proxy_cache api_cache; proxy_cache_key "$scheme$request_uri$http_accept_language";
    proxy_cache_valid 200 5s; proxy_cache_lock on;
    proxy_set_header Cookie "";
    add_header X-Cache-Status $upstream_cache_status always;
    proxy_pass http://api;
  }
  location /api/ {
    limit_req zone=api_ip burst=40 nodelay;
    error_page 429 = @rate_limited;
    error_page 502 503 504 = @upstream_unavailable;
    proxy_pass http://api;
  }
  location /media/ {                                                  # images, cached 1 day (DR-38)
    include /etc/nginx/snippets/security-headers.conf;
    proxy_cache media_cache; proxy_cache_key "$scheme$request_uri";
    proxy_cache_valid 200 1d; proxy_cache_lock on;
    proxy_set_header Cookie "";
    add_header X-Cache-Status $upstream_cache_status always;
    proxy_pass http://api;
  }
  location /v3/api-docs { proxy_pass http://api; }                    # only exists under the dev profile

  location /assets/ {
    include /etc/nginx/snippets/security-headers.conf;
    root /usr/share/nginx/html;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
  }
  location / {
    include /etc/nginx/snippets/security-headers.conf;
    root /usr/share/nginx/html;
    try_files $uri /index.html;
    add_header Cache-Control "no-cache" always;
  }

  location @rate_limited {
    default_type application/problem+json;
    add_header Retry-After 1 always;
    add_header X-Request-Id $req_id always;
    return 429 '{"type":"https://errors.ticket.dev/RATE_LIMITED","title":"Too many requests","status":429,"detail":"Rate limit exceeded at the edge.","code":"RATE_LIMITED","requestId":"$req_id","retryAfterSeconds":1}';
  }
  location @upstream_unavailable {
    default_type application/problem+json;
    add_header Retry-After 2 always;
    add_header X-Request-Id $req_id always;
    return 503 '{"type":"https://errors.ticket.dev/OVERLOADED","title":"Service unavailable","status":503,"detail":"The service is not reachable. Try again shortly.","code":"OVERLOADED","requestId":"$req_id","retryAfterSeconds":2}';
  }
}
